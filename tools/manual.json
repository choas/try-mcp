[
 {
  "id": "modelcontextprotocol/servers:filesystem",
  "slug": "filesystem",
  "name": "Filesystem",
  "group": "Reference servers",
  "desc": "Read and write files inside the directories you allow.",
  "link": "https://github.com/modelcontextprotocol/servers",
  "source": "manual",
  "options": [
   {
    "kind": "stdio",
    "label": "Local (npx)",
    "command": "npx",
    "args": [
     "-y",
     "@modelcontextprotocol/server-filesystem",
     "${ALLOWED_DIRECTORY}"
    ],
    "env": {},
    "params": [
     {
      "key": "ALLOWED_DIRECTORY",
      "desc": "Directory the server may access",
      "required": true,
      "secret": false,
      "hint": "/path/to/folder"
     }
    ]
   }
  ],
  "v2": null
 },
 {
  "id": "modelcontextprotocol/servers:git",
  "slug": "git",
  "name": "Git",
  "group": "Reference servers",
  "desc": "Read, search and change a local Git repository.",
  "link": "https://github.com/modelcontextprotocol/servers",
  "source": "manual",
  "options": [
   {
    "kind": "stdio",
    "label": "Local (uvx)",
    "command": "uvx",
    "args": [
     "mcp-server-git",
     "--repository",
     "${REPOSITORY_PATH}"
    ],
    "env": {},
    "params": [
     {
      "key": "REPOSITORY_PATH",
      "desc": "Path to the Git repository",
      "required": true,
      "secret": false,
      "hint": "/path/to/repo"
     }
    ]
   }
  ],
  "v2": null
 },
